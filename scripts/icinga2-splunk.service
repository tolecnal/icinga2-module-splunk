[Unit]
Description=Icinga2 to Splunk Event Stream Integration
After=network.target icinga2.service
Wants=icinga2.service

[Service]
Type=simple
User=nagios
Group=nagios
# Set working directory to the parent of the package directory so Python
# can import the package as `icinga2_splunk` (e.g. /usr/local/bin/icinga2_splunk).
WorkingDirectory=/usr/local/bin
Environment="PYTHONUNBUFFERED=1"
# Run the package as a module so imports like `from icinga2_splunk.config import ...`
# resolve correctly without requiring the package to be installed system-wide.
ExecStart=/usr/bin/python3 -m icinga2_splunk.event_stream_client
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/icinga2

[Install]
WantedBy=multi-user.target
