{
  "icinga2_api_url": "https://icinga2-server:5665",
  "icinga2_api_username": "splunk",
  "icinga2_api_password": "your-password",
  "icinga2_api_verify_ssl": "/var/lib/icinga2/certs/ca.crt",
  "icinga2_api_tls_server_name": "",

  "splunk_hec_url": "https://splunk-server:8088",
  "splunk_hec_token": "your-hec-token",
  "splunk_verify_ssl": true,
  "splunk_index_events": "icinga2_events",
  "splunk_index_perfdata": "icinga2_perfdata",

  "event_types": [
    "StateChange",
    "Notification",
    "AcknowledgementSet",
    "AcknowledgementCleared",
    "DowntimeAdded",
    "DowntimeRemoved"
  ],
  "event_stream_queue": "splunk",
  "event_stream_filter": "",

  "include_check_results": false,
  "check_result_state_filter": [1, 2, 3],
  "include_perfdata": true,

  "batch_size": 100,
  "batch_timeout": 10,
  "max_queue_size": 10000,
  "retry_max_interval": 60,

  "spool_dir": "/var/lib/icinga2-splunk/spool",
  "spool_max_size_mb": 1024,
  "spool_max_age_days": 7,

  "heartbeat_timeout": 300,

  "log_level": "INFO"
}
