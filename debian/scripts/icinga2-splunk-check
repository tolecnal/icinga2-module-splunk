#!/usr/bin/python3
"""Entry point installed by the Debian package."""

import os
import sys

# The package keeps its configuration in /etc/icinga2-splunk.
os.environ.setdefault("ICINGA2_SPLUNK_CONFIG", "/etc/icinga2-splunk/splunk_config.json")

from icinga2_splunk.check_connection import main

sys.exit(main())
